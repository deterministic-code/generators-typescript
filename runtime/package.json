{
  "name": "@deterministic-code/deterministic",
  "version": "0.0.7",
  "description": "TypeScript base classes used to generate REST and GraphQL APIs.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js",
      "require": "./dist/errors.cjs"
    },
    "./responses": {
      "types": "./dist/responses.d.ts",
      "import": "./dist/responses.js",
      "require": "./dist/responses.cjs"
    },
    "./middleware": {
      "types": "./dist/middleware.d.ts",
      "import": "./dist/middleware.js",
      "require": "./dist/middleware.cjs"
    },
    "./repositories": {
      "types": "./dist/repositories.d.ts",
      "import": "./dist/repositories.js",
      "require": "./dist/repositories.cjs"
    },
    "./routes": {
      "types": "./dist/routes.d.ts",
      "import": "./dist/routes.js",
      "require": "./dist/routes.cjs"
    },
    "./services": {
      "types": "./dist/services.d.ts",
      "import": "./dist/services.js",
      "require": "./dist/services.cjs"
    },
    "./app": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js",
      "require": "./dist/app.cjs"
    },
    "./validators": {
      "types": "./dist/validators.d.ts",
      "import": "./dist/validators.js",
      "require": "./dist/validators.cjs"
    },
    "./converters": {
      "types": "./dist/converters.d.ts",
      "import": "./dist/converters.js",
      "require": "./dist/converters.cjs"
    },
    "./migrate": {
      "types": "./dist/migrate.d.ts",
      "import": "./dist/migrate.js",
      "require": "./dist/migrate.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:functional": "vitest run --config vitest.functional.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --config vitest.coverage.config.ts --coverage",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@deterministic-code/generators-common": "github:deterministic-code/generators-common#main",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "helmet": "^8.0.0",
    "js-yaml": "^4.1.1",
    "jsonwebtoken": "^9.0.2",
    "pluralize": "^8.0.0",
    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "mssql": "^12.5.0",
    "mysql2": "^3.22.2",
    "oracledb": "^6.10.0",
    "pg": "^8.13.0"
  },
  "peerDependenciesMeta": {
    "mssql": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "oracledb": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/mssql": "^12.3.0",
    "@types/node": "^22.10.0",
    "@types/oracledb": "^6.10.3",
    "@types/pg": "^8.11.10",
    "mysql2": "^3.22.2",
    "@types/pluralize": "^0.0.33",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^2.1.0",
    "prettier": "^3.4.0",
    "supertest": "^7.0.0",
    "testcontainers": "^11.14.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.4.0",
    "vitest": "^2.1.0"
  }
}
