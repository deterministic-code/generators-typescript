import { describe, it, expect, vi, beforeEach } from "vitest";
{{&prelude}}import express, { type Application } from "express";
import request from "supertest";
{{&pkImport}}
import { {{fnName}} } from "../{{fileBase}}";

{{&mockFactory}}
describe("{{fnName}}", () => {
  let service: any;
  let app: Application;

  beforeEach(() => {
    service = createMock({{&pkExpr}});
    app = express();
    app.use(express.json());
    app.use("{{mountPath}}", {{fnName}}(service));
  });

  it("GET {{mountPath}} returns items from service.findAll", async () => {
    service.findAll.mockResolvedValueOnce([{ {{&createRowLiteral}}{{&fkSuffix}} }]);
    const res = await request(app).get("{{mountPath}}");
    expect(res.status).toBe(200);
    expect(service.findAll).toHaveBeenCalledOnce();
  });

  it("GET {{mountPath}}/{{memberLabel}} returns the entity from service.findById", async () => {
    const id = {{&idExpr}};
    service.findById.mockResolvedValueOnce({ {{&rowLiteral}}{{&fkSuffix}} });
    const res = await request(app).get(`{{mountPath}}/${{{&idPathExpr}}}`);
    expect(res.status).toBe(200);
    expect(res.body).toMatchObject({ {{&rowLiteral}} });
    expect(service.findById).toHaveBeenCalledWith(id);
  });

  it("GET {{mountPath}}/{{memberLabel}} returns 404 when service.findById yields null", async () => {
    const id = {{&idExpr}};
    service.findById.mockResolvedValueOnce(null);
    const res = await request(app).get(`{{mountPath}}/${{{&idPathExpr}}}`);
    expect(res.status).toBe(404);
  });
{{&byFieldsBlock}}
});
