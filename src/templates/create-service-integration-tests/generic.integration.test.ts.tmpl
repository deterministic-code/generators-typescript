{{&prelude}}import { describe, it, expect, beforeEach, afterEach } from "vitest";
import { copyFile, mkdtemp, rm } from "node:fs/promises";
import { tmpdir } from "node:os";
import { join } from "node:path";
import {
  PrimaryKeyService,
  SqliteDatasource,
  SqliteStandardRepository,
} from "{{repositoriesImport}}";
import { {{className}} } from "{{serviceImport}}";
{{#parentImports}}import { {{className}} } from "{{importPath}}";
{{/parentImports}}
{{#typeImports}}import type { {{names}} } from "{{fromPath}}";
{{/typeImports}}
const TABLE_NAME = {{&tableNameJson}};
const primaryKeys = new PrimaryKeyService([
{{#pkEntries}}  { entityName: {{&entityNameJson}}, primaryKeyColumn: {{&columnJson}}, primaryKeyIdType: {{&pkIdTypeJson}} },
{{/pkEntries}}]);

describe("{{className}} (sqlite integration)", () => {
  let tmpDir: string;
  let dbPath: string;
  let datasource: SqliteDatasource;
  let service: {{className}};

  beforeEach(async () => {
    const prebuilt = process.env.npm_package_config_test_db;
    if (!prebuilt) {
      throw new Error(
        "npm_package_config_test_db is unset — run via `npm test` so the pretest hook materializes the prebuilt sqlite via migrate-setup --and-up.",
      );
    }
    tmpDir = await mkdtemp(join(tmpdir(), "{{entityName}}-itest-"));
    dbPath = join(tmpDir, "test.db");
    await copyFile(prebuilt, dbPath);
    datasource = new SqliteDatasource({
      dbPath,
      pragmas: ["foreign_keys = ON"],
    });
    await datasource.open();
    await datasource.query(`DELETE FROM ${TABLE_NAME}`);
    const repository = new SqliteStandardRepository<{{rowTypeName}}>(
      datasource,
      TABLE_NAME,
      { entityName: {{&entityNameJson}}, primaryKeys },
    );
    service = new {{className}}(repository{{&serviceOptions}});
  });

  afterEach(async () => {
    await datasource.close();
    await rm(tmpDir, { recursive: true, force: true });
  });

  it("findAll returns [] on an empty table", async () => {
    expect(await service.findAll()).toEqual([]);
  });
{{#canCreate}}
  it("create inserts a row and auto-populates {{stampCols}}", async () => {
    const row = await service.create({}{{#createTypeName}} as {{createTypeName}}{{/createTypeName}});
    const r = row as unknown as Record<string, unknown>;
    expect(typeof r.id).toBe("{{idTsType}}");
{{#withUuid}}    expect(typeof r.uuid).toBe("string");
{{/withUuid}}    expect(typeof r.created).toBe("string");
    expect(typeof r.updated).toBe("string");
  });
{{/canCreate}}
  it("findById returns null for a missing id", async () => {
    expect(await service.findById({{&missingId}})).toBeNull();
  });

  it("update returns null for a missing id", async () => {
    const result = await service.update({{&missingId}}, {});
    expect(result).toBeNull();
  });

  it("delete returns false when the row does not exist", async () => {
    expect(await service.delete({{&missingId}})).toBe(false);
  });

{{#hierarchy}}
  it("create, update, and delete with parents", async () => {
{{#chainServices}}    const {{varName}} = new {{className}}(
      new SqliteStandardRepository<{{rowTypeName}}>(datasource, {{&tableNameJson}}, {
        entityName: {{&entityNameJson}},
        primaryKeys,
      }){{&serviceOptions}},
    );
{{/chainServices}}
{{#creates}}{{#isLookup}}    const {{varName}} = await {{serviceVar}}.findById({{&seedId}});
    expect({{varName}}).not.toBeNull();
    if ({{varName}} === null) {
      throw new Error({{&missingSeedErrorJson}});
    }
{{/isLookup}}{{^isLookup}}    const {{varName}} = await {{serviceVar}}.create({
{{#fields}}      {{ident}}: {{&expr}},
{{/fields}}    }{{#createTypeName}} as {{createTypeName}}{{/createTypeName}});
{{/isLookup}}{{/creates}}
{{#updates}}    const {{updatedVarName}} = await {{serviceVar}}.update({{varName}}.{{pkIdent}}, {
{{#fields}}      {{ident}}: {{&expr}},
{{/fields}}    });
    expect({{updatedVarName}}).not.toBeNull();
{{/updates}}
{{#deletes}}    expect(await {{serviceVar}}.delete({{varName}}.{{pkIdent}})).toBe(true);
    expect(await {{serviceVar}}.findById({{varName}}.{{pkIdent}})).toBeNull();
{{/deletes}}  });
{{/hierarchy}}{{#missingLookupSeed}}
  // Seed data does not exist for readonly-lookup "{{lookupName}}", so this test (and the remainder) cannot be written.
{{/missingLookupSeed}}
});
