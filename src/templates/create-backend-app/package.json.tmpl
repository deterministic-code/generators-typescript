{
  "name": "{{appName}}",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env {{serverFile}}",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/{{serverFileBase}}.js",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "allowScripts": {
    "@scarf/scarf": true,
    "better-sqlite3": true,
    "core-js": true,
    "esbuild": true
  },
  "overrides": {
    "better-sqlite3": "^13.0.3",
    "glob": "^13.0.6"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.17.0",
    "vitest": "^2.1.8"
  }
}
