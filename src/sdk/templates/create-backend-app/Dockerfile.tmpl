# syntax=docker/dockerfile:1
FROM node:26-alpine
{{apkClientsBegin}}
RUN apk add --no-cache git
{{apkClientsEnd}}
WORKDIR {{workDir}}
COPY {{tsPrefix}}package*.json {{tsPrefix}}tsconfig.json ./
RUN --mount=type=cache,target=/root/.npm npm install
COPY {{tsPrefix}}. ./
{{deterministicCopy}}{{migrateCopyBegin}}
{{migrateCopyEnd}}
RUN npm run build{{deterministicLibraryRuntimeCopy}}
RUN chmod +x scripts/entrypoint.sh
ENV SRC_ROOT={{workDir}}/dist
EXPOSE 4000
HEALTHCHECK --interval=5s --timeout=3s --start-period=5s --retries=6 \
  CMD node -e "const r=require('http').get('http://localhost:4000/api/health',{timeout:2500},(res)=>{console.log('HTTP',res.statusCode);process.exit(res.statusCode===200?0:1)});r.on('error',(e)=>{console.error(e.code||e.message);process.exit(1)});r.on('timeout',()=>{console.error('timeout');r.destroy();process.exit(1)})"
ENTRYPOINT ["./scripts/entrypoint.sh"]
CMD ["node", "dist/server.js"]
